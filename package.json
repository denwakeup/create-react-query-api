{
  "name": "create-react-query-api",
  "version": "1.0.1",
  "description": "react query api builder",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.umd.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/denwakeup/create-react-query-api.git"
  },
  "keywords": [
    "react",
    "react-query"
  ],
  "size-limit": [
    {
      "path": "dist/index.umd.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.es.js",
      "limit": "10 KB"
    }
  ],
  "scripts": {
    "build": "yarn clear:build && vite build",
    "clear:build": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --colors",
    "prepack": "yarn test && yarn build",
    "reinstall": "rimraf node_modules && yarn",
    "types:check": "tsc --noEmit",
    "lint": "biome check --write .",
    "size": "size-limit",
    "prepare": "husky",
    "lint:check": "biome check ."
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.25.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "2.6.6",
    "@rollup/plugin-typescript": "^12.3.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.0",
    "size-limit": "^14.3.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
